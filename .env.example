# Runtime env is validated via Zod (lib/env.ts) on app boot.
# Set SKIP_ENV_VALIDATION=1 only for CI tooling that must install without secrets.

# GitHub token for scraper, live release refresh, and user repo submissions
GITHUB_TOKEN=ghp_your_token_here

# Shared secret for /api/cron/* routes. Vercel sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" when the env var is set on the project.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace_with_a_long_random_secret

# Cron batch sizes. Routes are capped at 60s (Vercel Hobby limit), so keep
# these small; the batch also self-stops after ~50s. Raise on Pro plans.
# CRON_UPDATE_LIMIT=15
# CRON_DISCOVER_LIMIT=8

# App / scraper database (day-to-day local or prod, depending on environment)
# Local Prisma Postgres from: pnpm db:dev
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/github_releases?sslmode=disable"

# Used by: pnpm db:migrate-scrape  (copy repos + releases local → prod; scrape ledger stays local)
# LOCAL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/github_releases?sslmode=disable"
# PROD_DATABASE_URL="postgresql://USER:PASS@HOST/neondb?sslmode=require"

# Optional: used by prisma migrate diff/dev (never touches your app DB data)
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:51214/prisma_migrate_shadow?sslmode=disable"

# Public site URL (canonical + SEO). Production:
# NEXT_PUBLIC_SITE_URL=https://open-releases.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (optional; omit to disable)
# NEXT_PUBLIC_GA_ID=G-EFHFFMD0FJ

# better-auth (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App — https://github.com/settings/developers
# Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
# (Separate from GITHUB_TOKEN used by the scraper)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
