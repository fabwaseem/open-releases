generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Published release catalog entry shown in the directory UI.
model Repository {
  id            String    @id @default(cuid())
  fullName      String    @unique
  name          String
  owner         String
  description   String?
  url           String
  homepage      String?
  stars         Int       @default(0)
  language      String?
  topics        Json      @default("[]")
  license       String?
  avatarUrl     String?
  pushedAt      DateTime?
  releasesCount Int?
  platforms     Json      @default("[]")
  hasWindows    Boolean   @default(false)
  hasMacos      Boolean   @default(false)
  hasLinux      Boolean   @default(false)
  hasAndroid    Boolean   @default(false)
  hasIos        Boolean   @default(false)
  /// Soft-hide from the public directory without deleting scrape history.
  hidden        Boolean   @default(false)
  hiddenReason  String?
  /// Pinned near the top of the default directory sort (still respects filters).
  featured      Boolean   @default(false)
  featuredAt    DateTime?
  scrapedAt     DateTime  @default(now())
  releaseCheckedAt DateTime?

  /// Weighted activity score 0–100 (see lib/score.ts).
  activityScore          Float     @default(0)
  scoreNewStars          Float     @default(0)
  scoreReleaseFrequency  Float     @default(0)
  scoreRecentCommits     Float     @default(0)
  scoreContributorGrowth Float     @default(0)
  scoreIssueActivity     Float     @default(0)
  /// Snapshots used to compute deltas on the next scrape.
  previousStars          Int?
  previousContributors   Int?
  contributorsCount      Int?
  scoredAt               DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  latestRelease Release?
  scrapeRecord  ScrapeRecord?
  favorites     Favorite[]
  submissions   RepoSubmission[]

  @@index([hidden, activityScore])
  @@index([hidden, featured, activityScore])
  @@index([hidden, stars])
  @@index([pushedAt])
  @@index([hasWindows])
  @@index([hasMacos])
  @@index([hasLinux])
  @@index([hasAndroid])
  @@index([hasIos])
  @@index([language])
  @@index([featured])
}

model Release {
  id           String    @id @default(cuid())
  repositoryId String    @unique
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  tag          String
  name         String?
  publishedAt  DateTime?
  url          String?
  prerelease   Boolean   @default(false)
  body         String?
  platforms    Json      @default("[]")
  hasWindows   Boolean   @default(false)
  hasMacos     Boolean   @default(false)
  hasLinux     Boolean   @default(false)
  hasAndroid   Boolean   @default(false)
  hasIos       Boolean   @default(false)
  /// Installer / app packages (exe, dmg, AppImage, apk, ipa, …)
  assets       Json      @default("[]")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tag])
  @@index([publishedAt])
}

/// Ledger of every discovered repo — prevents re-enriching known fullNames.
model ScrapeRecord {
  id           String   @id @default(cuid())
  fullName     String   @unique
  /// discovered | skipped_no_releases | skipped_no_assets | skipped_inactive | saved | error | hidden
  status       String
  reason       String?
  repositoryId String?  @unique
  repository   Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([lastSeenAt])
}

// ——— better-auth ———

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("user")
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  favorites     Favorite[]
  submissions   RepoSubmission[] @relation("SubmittedRepos")
  reviews       RepoSubmission[] @relation("ReviewedRepos")

  @@unique([email])
  @@map("user")
}

/// User-submitted repo awaiting admin approval before entering the catalog.
model RepoSubmission {
  id            String    @id @default(cuid())
  fullName      String
  sourceUrl     String
  /// pending | approved | rejected
  status        String    @default("pending")
  note          String?
  reviewNote    String?
  /// Snapshot from GitHub preview at submit time.
  preview       Json
  submittedById String
  submittedBy   User      @relation("SubmittedRepos", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedById  String?
  reviewedBy    User?     @relation("ReviewedRepos", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  repositoryId  String?
  repository    Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([fullName])
  @@index([submittedById])
  @@map("repo_submission")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Favorite {
  id           String     @id @default(cuid())
  userId       String
  repositoryId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, repositoryId])
  @@index([userId])
  @@index([repositoryId])
  @@map("favorite")
}
